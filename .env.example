# --- Database (Turso / libSQL) -------------------------------------------
# Leave unset locally to use the on-disk SQLite file at ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Web Push -------------------------------------------------------------
# Generate with: npm run vapid:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# --- Scheduled jobs -------------------------------------------------------
# Vercel sends this as "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Public site ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# --- Legal / operator identity (shown in the legal pages) -----------------
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_VAT=
NEXT_PUBLIC_OPERATOR_EMAIL=
